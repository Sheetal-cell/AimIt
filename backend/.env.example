DATABASE_URL=postgresql+psycopg://momentum_user:change_this_local_password@localhost:5433/momentum
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=60

# Password reset email via Gmail SMTP (set these in Render Environment)
# Enable 2-Step Verification on the Gmail account, then create a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-dedicated-sender@gmail.com
SMTP_PASSWORD=your_google_app_password
# Optional; defaults to SMTP_USERNAME
SMTP_FROM_EMAIL=AimIt <your-dedicated-sender@gmail.com>
FRONTEND_URL=https://aim-it-six.vercel.app
